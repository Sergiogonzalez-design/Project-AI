{
  "expo": {
    "name": "AIKinora",
    "slug": "physioguidea",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F8FAFF"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.physioguidea.app",
      "buildNumber": "15",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSUserNotificationsUsageDescription": "AIKinora envía recordatorios de Physio para ayudarte con tu recuperación.",
        "NSMicrophoneUsageDescription": "AIKinora usa el micrófono para que puedas dictar tu consulta por voz.",
        "NSSpeechRecognitionUsageDescription": "AIKinora usa el reconocimiento de voz para convertir lo que dices en texto en el chat.",
        "NSCameraUsageDescription": "AIKinora necesita la cámara para tu foto de perfil o para fotografiar la zona lesionada.",
        "NSPhotoLibraryUsageDescription": "AIKinora necesita acceso a tus fotos para tu foto de perfil o para adjuntar una imagen de la lesión.",
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        }
      },
      "privacyManifests": {
        "NSPrivacyTracking": false,
        "NSPrivacyTrackingDomains": [],
        "NSPrivacyCollectedDataTypes": [],
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": [
              "CA92.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryFileTimestamp",
            "NSPrivacyAccessedAPITypeReasons": [
              "C617.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryDiskSpace",
            "NSPrivacyAccessedAPITypeReasons": [
              "E174.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategorySystemBootTime",
            "NSPrivacyAccessedAPITypeReasons": [
              "35F9.1"
            ]
          }
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png",
        "backgroundColor": "#1D4ED8"
      },
      "package": "com.physioguidea.app",
      "versionCode": 1,
      "softwareKeyboardLayoutMode": "resize",
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      "expo-secure-store",
      "expo-localization",
      "expo-video",
      "expo-document-picker",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "backgroundColor": "#F8FAFF",
          "resizeMode": "contain"
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#2563EB",
          "defaultChannel": "AIKinora-reminders"
        }
      ],
      "./plugins/withPhysioNotificationLargeIcon.js",
      [
        "expo-image-picker",
        {
          "photosPermission": "AIKinora necesita acceso a tus fotos para tu foto de perfil o para adjuntar una imagen de la lesión.",
          "cameraPermission": "AIKinora necesita la cámara para tu foto de perfil o para fotografiar la zona lesionada."
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "AIKinora usa el micrófono para que puedas dictar tu consulta por voz.",
          "speechRecognitionPermission": "AIKinora usa el reconocimiento de voz para convertir lo que dices en texto en el chat.",
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox"
          ]
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "d7b0ed1a-d988-4c02-a42b-057d701049c9"
      }
    },
    "owner": "sergiogonzalez"
  }
}
