// Cloudflare Workers Builds: set build command to `npm run build:cloudflare` in the dashboard.
// Vercel uses `npm run build` (Next.js). Do not point Workers Builds at `next build` alone.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "projectai",
  "main": ".open-next/worker.js",
  "compatibility_date": "2024-12-30",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "projectai"
    }
  ]
}
